# =========================================================
# SongRoulette .gitignore
# =========================================================

# ---------------------------------------------------------
# Environment variables / secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
backend/**/*.pyc

__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python logs / cache / tests
*.log
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Local databases
db.sqlite3
db.sqlite3-journal

# ---------------------------------------------------------
# Node / React / Vite
# ---------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
node_modules/
dist/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------
# Docker / local runtime
# ---------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------
# Editors / IDE
# ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------
# OS files
# ---------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------
# Jupyter / notebooks cache
# ---------------------------------------------------------
.ipynb_checkpoints

# ---------------------------------------------------------
# Misc
# ---------------------------------------------------------
tempCodeRunnerFile.py